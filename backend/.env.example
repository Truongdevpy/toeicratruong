# Database connection string (defaults to SQLite platform.db if omitted)
# DATABASE_URL=sqlite:///platform.db
# DATABASE_URL=postgresql://user:password@localhost:5432/toeic_db

# Google Gemini API Keys (comma-separated for key rotation and load balancing)
GEMINI_API_KEYS="YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2"

# Security & JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
