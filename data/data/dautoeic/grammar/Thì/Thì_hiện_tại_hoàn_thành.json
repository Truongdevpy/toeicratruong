            "title": "Câu này hỏi gì",
            "blocks": [
              {
                "text": "Bốn đáp án gồm ba dạng của động từ “submit” và danh từ “submission”.",
                "type": "paragraph"
              },
              {
                "type": "structure",
                "parts": [
                  {
                    "role": "S",
                    "text": "Several companies",
                    "label": "chủ ngữ"
                  },
                  {
                    "role": "V",
