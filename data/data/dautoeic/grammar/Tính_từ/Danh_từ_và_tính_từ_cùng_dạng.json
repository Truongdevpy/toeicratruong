                    "giám đốc, người điều hành"
                  ],
                  [
                    "commercial",
                    "thương mại",
                    "quảng cáo (trên truyền hình)"
                  ],
                  [
                    "chemical",
                    "hóa học",
                    "hóa chất"
                  ],
                  [
                    "objective",
                    "khách quan",
                    "mục tiêu"
                  ],
                  [
                    "relative",
                    "tương đối",
                    "họ hàng"
                  ],
                  [
                    "principal",
                    "chính",
                    "hiệu trưởng, người đứng đầu"
                  ],
                  [
                    "representative",
                    "tiêu biểu, đại diện",
                    "người đại diện"
                  ]
                ],
                "type": "table",
                "headers": [
                  "Từ",
                  "Làm tính từ",
                  "Làm danh từ"
                ]
              },
              {
                "type": "bullets",
                "items": [
                  "Làm danh từ thì phải đúng số: **a / an / each / every** + danh từ đếm được số ít (*an official*, *every chemical*); động từ số ít **is** đi với chủ ngữ số ít.",
                  "Danh từ không đếm được (professionalism, chemistry) không đi với a / an / every.",
                  "Danh từ đứng trước danh từ khác để ở dạng số ít; ngoại lệ là vài từ luôn có -s như **sales**: *a sales representative*."
                ]
              },
              {
                "text": "**Phân biệt với các đáp án sai trong bài tập**",
                "type": "paragraph"
              },
              {
                "type": "compare",
                "items": [
                  {
                    "why": "Có danh từ ngay sau: làm tính từ (adj + N). Không có danh từ theo sau: làm danh từ, đúng số ít hay số nhiều.",
                    "form": "Từ cùng dạng (official, original, executive…)",
                    "example": "*the official opening*; *an official from the city*",
                    "verdict": "right"
                  },
                  {
                    "why": "Không bổ nghĩa cho danh từ, cũng không làm chủ ngữ hay tân ngữ sau mạo từ, từ hạn định.",
                    "form": "Trạng từ (officially, originally, commercially…)",
                    "verdict": "wrong"
                  },
                  {
                    "why": "Không đứng sau mạo từ, từ hạn định hay tính từ; không bổ nghĩa cho danh từ theo sau.",
                    "form": "Động từ (officiate, originate, execute, individualize, commercialize…)",
                    "verdict": "wrong"
                  },
                  {
                    "why": "Các dạng này trong bài tập không phải danh từ nên không làm danh từ chính sau mạo từ; đứng trước danh từ thì cho nghĩa không hợp, như *the executed committee*.",
                    "form": "V-ing, V-ed (representing, represented, originated, alternated, executed, commercialized)",
                    "verdict": "wrong"
                  },
                  {
                    "why": "Trong các câu bài tập, đứng trước danh từ thì không tạo cụm có nghĩa (*the principle reason*); đứng ở vị trí danh từ thì nghĩa không hợp câu.",
                    "form": "Danh từ cùng gốc khác nghĩa (individuality, professionalism, commerce, relation, originality, objectivity, alternation, chemistry, execution, principle)",
                    "verdict": "wrong"
                  },
                  {
                    "why": "Không đi sau a / an / each / every, không hợp với động từ số ít is, không đứng trước danh từ khác để bổ nghĩa.",
                    "form": "Danh từ số nhiều (officials, chemicals, objectives, principals, objects, alternates)",
                    "verdict": "wrong"
                  }
                ]
              }
            ]
          },
