                ]
              },
              {
                "rows": [
                  [
                    "tính từ không có đuôi riêng (brief, quick, exact)",
                    "thêm -ly",
                    "briefly, quickly, exactly, promptly, politely, completely, perfectly"
                  ],
                  [
                    "tính từ đuôi -ent / -ant",
                    "thêm -ly",
                    "currently, efficiently, frequently, recently, significantly"
                  ],
                  [
                    "tính từ đuôi -ate",
                    "thêm -ly",
                    "accurately, immediately"
                  ],
                  [
                    "tính từ đuôi -ful",
                    "thêm -ly",
                    "carefully, successfully"
