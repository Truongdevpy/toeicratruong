                "type": "steps",
                "items": [
                  {
                    "text": "Câu hỏi là một từ đơn, bốn đáp án là Danh từ / Động từ / Tính từ / Trạng từ thì đây là câu hậu tố: nhận ra loại từ qua đuôi.",
                    "title": "Nhìn 4 đáp án"
                  },
                  {
                    "text": "Tách từ thành gốc + đuôi. Xem đuôi cuối cùng có phải -ly không, và phần trước -ly có phải tính từ không.",
                    "title": "Phân tích câu"
                  },
                  {
                    "text": "Tính từ + -ly thì chọn Trạng từ; loại Tính từ vì tính từ chỉ là phần gốc; loại Danh từ, Động từ vì từ không mang đuôi của các loại đó.",
                    "title": "Chọn và loại"
                  }
                ]
              }
